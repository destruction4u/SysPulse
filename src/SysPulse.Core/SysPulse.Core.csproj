<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by the desktop app and the agent service: measurement code + the network protocol. -->
  <PropertyGroup>
    <!-- Plain net10.0 (not -windows) so the agent can run on Linux. Windows-only code is
         marked [SupportedOSPlatform("windows")] and only reached behind OperatingSystem checks. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SysPulse.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="11.0.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests drive the Linux readers against a fake /proc + /sys tree -->
    <InternalsVisibleTo Include="SysPulse.Core.Tests" />
  </ItemGroup>

</Project>
