<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Service (Windows) / daemon (Linux) that serves this PC's readings to SysPulse viewers on the local network. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>SysPulse.Agent</RootNamespace>

    <ApplicationIcon>..\SysPulse\Assets\SysPulse.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>SysPulse Agent</Product>
    <AssemblyTitle>SysPulse Agent</AssemblyTitle>
    <Description>Shares this PC's health and resource readings with SysPulse on your local network</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!-- Linux builds: no dependency on the ICU library (missing on minimal servers). We don't need culture data. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the 10.0 line to match the ASP.NET Core 10 shared framework.
         Each is a no-op unless the process was started by that service manager. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <ProjectReference Include="..\SysPulse.Core\SysPulse.Core.csproj" />
  </ItemGroup>

</Project>
